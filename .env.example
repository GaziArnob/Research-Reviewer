# Copy to .env and edit. Never commit .env.

# PostgreSQL (free). Matches docker-compose.yml below; change if you use your own server.
DATABASE_URL=postgresql+psycopg://reviewer:reviewer@localhost:5433/reviewer

# Sent to Crossref / OpenAlex as a polite-pool contact. Use your own email.
CONTACT_EMAIL=you@example.com

# Optional: raises Semantic Scholar rate limit. Leave empty to stay anonymous.
SEMANTIC_SCHOLAR_API_KEY=

# LLM (Phase 2+). "none" keeps everything rule-based and free.
LLM_PROVIDER=none
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192

# Pipeline limits
MIN_WORDS=500
MAX_REFS_TO_VERIFY=60
ONLINE_CHECKS=true

# Web app (uvicorn webapp.main:app)
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
BRAND_NAME=Research Reviewer
ALLOW_SIGNUP=true
COOKIE_SECURE=false          # set true when served over HTTPS
MAX_UPLOAD_MB=25
SUPPORT_EMAIL=support@example.com
