# Copy to .env.prod on the SERVER and fill in. Never commit .env.prod.
# Your domain, already pointing (A record) at the server's public IP. A free one from duckdns.org works.
DOMAIN=reviewer.example.com
# Generate each with:  openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=
# Used as the polite contact for Crossref / OpenAlex and shown as support address.
CONTACT_EMAIL=
# Set to false after you and your testers have created accounts, to close public sign-up.
ALLOW_SIGNUP=true
OLLAMA_MODEL=qwen2.5:3b
